{
  "name": "@magicsandbox.ai/streaming",
  "version": "0.2.0",
  "homepage": "https://github.com/magicsandbox-ai/magicsandbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicsandbox-ai/magicsandbox.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules ../../../node_modules/jest/bin/jest.js",
    "build": "tsc"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "transform": {
      "^.+.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testPathIgnorePatterns": [
      "testUtils.js",
      "testUtils.ts"
    ]
  }
}
