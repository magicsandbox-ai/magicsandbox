{
  "name": "@magicsandbox.ai/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@magicsandbox.ai/build-docs": "file:packages/js/build-docs",
    "@magicsandbox.ai/dev": "file:packages/js/dev",
    "@magicsandbox.ai/test": "file:packages/js/test",
    "dotenv": "^16.4.7",
    "esbuild": "0.23.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.6"
  },
  "scripts": {
    "init": "magicsandbox init -d apps",
    "dev": "magicsandbox dev -d apps -p 3002 --url http://localhost:3000",
    "test": "magicsandbox test -d apps -p 3002 --url http://localhost:3000",
    "publish-function": "magicsandbox publish -d functions --url http://localhost:3000",
    "publish": "magicsandbox publish -d apps --url http://localhost:3000",
    "dev:prod": "magicsandbox dev -d apps",
    "test:prod": "magicsandbox test -d apps",
    "publish-function:prod": "magicsandbox publish -d functions",
    "publish:prod": "magicsandbox publish -d apps",
    "jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "pytest": "pipenv run pytest"
  },
  "jest": {
    "transform": {},
    "moduleNameMapper": {
      "^@components/(.*)$": "<rootDir>/components/$1"
    },
    "testPathIgnorePatterns": [
      "testUtils.js"
    ]
  }
}
