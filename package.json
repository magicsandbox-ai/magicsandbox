{
  "name": "@magicsandbox.ai/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@magicsandbox.ai/build-docs": "^0.1.0",
    "@magicsandbox.ai/dev": "^0.2.0",
    "@magicsandbox.ai/test": "^0.1.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "init": "magicsandbox init -d apps",
    "dev:local": "magicsandbox dev -d apps -p 3002 --url http://localhost:3000",
    "test:local": "magicsandbox test -d apps -p 3002 --url http://localhost:3000",
    "publish-function": "magicsandbox publish -d functions --url http://localhost:3000",
    "publish": "magicsandbox publish -d apps --url http://localhost:3000",
    "dev": "magicsandbox dev -d apps",
    "test": "magicsandbox test -d apps",
    "publish:prod": "node scripts/publish.js",
    "publish-package:prod": "node scripts/publishPackage.js",
    "jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "pytest": "pipenv run pytest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "transform": {
      "^.+.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^@components/(.*)$": "<rootDir>/components/$1"
    },
    "testPathIgnorePatterns": [
      "testUtils.js"
    ]
  }
}
