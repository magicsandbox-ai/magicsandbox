{
  author: "magicsandbox",
  name: "Notes",
  version: "0.1.1",
  description: "Take notes, create to-do lists, organize documents, and more",
  dependencies: {
    react: "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.408.0",
    "@handlewithcare/react-prosemirror": "^2.3.3",
    "prosemirror-markdown": "^1.13.1",
    "prosemirror-example-setup": "^1.2.3",
    diff: "^7.0.0",
    uuid: "^11.1.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/diff": "^7.0.2",
  },
  esbuildOptions: {
    //the dependencies for components are in node_modules
    //but node_modules is not a parent of components
    //so we need to add node_modules to nodePaths
    nodePaths: ["./node_modules"],
  },
  tailwindConfig: {
    content: ["apps/Notes/**/*.js", "components/**/*.js"],
  },
}
