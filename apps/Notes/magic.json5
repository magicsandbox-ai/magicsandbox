{
  name: "Notes",
  version: "0.1.0",
  description: "Take notes, to-do lists, and more",
  dependencies: {
    "@magicsandbox.ai/hooks": "file:../../packages/js/hooks",
    react: "^18.0.0",
    "react-dom": "^18.0.0",
    "lucide-react": "^0.408.0",
    "@handlewithcare/react-prosemirror": "^2.2.4",
    "prosemirror-markdown": "^1.13.1",
    "prosemirror-example-setup": "^1.2.3",
    diff: "^7.0.0",
    uuid: "^11.1.0",
  },
  esbuildOptions: {
    //the dependencies for components are in node_modules
    //but node_modules is not a parent of components
    //so we need to add node_modules to nodePaths
    nodePaths: ["./node_modules"],
  },
  tailwindConfig: {
    content: ["apps/Notes/**/*.js", "components/**/*.js"],
  },
}
