{
  name: "DevLocal",
  version: "0.1.0",
  private: true, //should only be launched by magicsandbox.ai/dev package
  esbuildOptions: {
    //the dependencies for components are in node_modules
    //but node_modules is not a parent of components
    //so we need to add node_modules to nodePaths
    nodePaths: ["./node_modules"],
  },
  tailwindConfig: {
    content: ["apps/DevLocal/**/*.js", "components/**/*.js"],
  },
  dependencies: {
    "@magicsandbox.ai/react-sandbox": "^0.1.0",
    "lucide-react": "^0.408.0",
    react: "^19.0.0",
    "react-dom": "^19.0.0",
  },
}
