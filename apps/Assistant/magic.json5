{
  author: "magicsandbox",
  name: "Assistant",
  version: "0.1.2",
  type: "assistant",
  esbuildOptions: {
    //the dependencies for components are in node_modules
    //but node_modules is not a parent of components
    //so we need to add node_modules to nodePaths
    nodePaths: ["./node_modules"],
    loader: { ".js": "jsx", ".md": "text" },
  },
  dependencies: {
    "@magicsandbox.ai/docs": "file:../../packages/js/docs",
    "@magicsandbox.ai/react-sandbox": "file:../../packages/js/react-sandbox",
    "@magicsandbox.ai/streaming": "file:../../packages/js/streaming",
    react: "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.408.0",
    unified: "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-react": "^8.0.0",
    "rehype-highlight": "^7.0.1",
    "unist-util-visit": "^5.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react-error-boundary": "^5.0.0",
  },
}
