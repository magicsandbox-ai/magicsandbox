{
  name: "Develop",
  version: "0.1.0",
  description: "Develop a Magic Sandbox app or function in the browser",
  esbuildOptions: {
    alias: {
      path: "path-browserify", //for eslint
      //setting fs and resolve to external didn't work, but they're never used
      //only used if react version is set to 'detect' in eslint
      fs: "./dummy.js",
      resolve: "./dummy.js",
    },
    inject: ["./processShim.js"], //for eslint
    loader: { ".js": "jsx", ".wasm": "binary" },
    //metafile: true,
    minify: true,
    sourcesContent: false,
    //the dependencies for components are in node_modules
    //but node_modules is not a parent of components
    //so we need to add node_modules to nodePaths
    nodePaths: ["./node_modules"],
  },
  tailwindConfig: {
    content: ["apps/Develop/**/*.js", "components/**/*.js"],
  },
  dependencies: {
    "@magicsandbox.ai/react-sandbox": "file:../../packages/js/react-sandbox",
  },
}
