{
  "manifest_version": 3,
  "name": "Magic Sandbox",
  "version": "0.1.0",
  "description": "Provides additional security when using magicsandbox.ai",
  "host_permissions": ["https://magicsandbox.ai/*", "http://localhost:3000/*"],
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  }
}
